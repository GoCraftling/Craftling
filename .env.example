PORT=8080
# gRPC AgentLink listen port — agents dial it and hold a command stream open.
GRPC_PORT=8090
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/craftling?sslmode=disable
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=720h

# Optional: seed/promote an admin on startup (both required to take effect)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Template registry (marketplace) index the control plane fetches templates from.
# TEMPLATE_INDEX_URL=https://registry.craftling.io/manifest.json

# --- Quotas / resource controls (P9) ---
# System default per-user quota, applied to any user without an admin override.
# Each limit uses 0 to mean unlimited on that axis. Enforced at server create.
# QUOTA_MAX_SERVERS=5
# QUOTA_MAX_CPUS=16
# QUOTA_MAX_MEMORY_MB=16384

# --- Billing (P9, pay-as-you-go hourly) ---
# Hourly price a running server accrues, per vCPU and per GB of memory.
# BILLING_CPU_HOUR=0.012
# BILLING_MEMORY_GB_HOUR=0.006
# BILLING_CURRENCY=USD

# --- Host agent (MODE=agent) ---
# CONTROL_PLANE_GRPC_ADDR=localhost:8090  # control plane's gRPC AgentLink the agent dials + streams to
# ADVERTISE_HOST=127.0.0.1                # player-facing connect host VMs report

# Agent VM backend: "fake" (default, in-memory) or "firecracker" (real microVMs).
# AGENT_RUNTIME=fake

# Firecracker driver (AGENT_RUNTIME=firecracker; requires /dev/kvm). Point these
# at a vmlinux kernel and a directory of per-version rootfs images you provide.
# FC_BINARY=firecracker            # firecracker executable (default: PATH)
# FC_KERNEL=/var/lib/craftling/vmlinux
# FC_IMAGE_DIR=/var/lib/craftling/images
# FC_DEFAULT_IMAGE=minecraft-1.20.4.ext4
# FC_WORK_DIR=                     # per-VM working dirs (default: OS temp dir)
